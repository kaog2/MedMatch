# Copy this file to .env for production and replace every placeholder.
ASPNETCORE_ENVIRONMENT=Production
NODE_ENV=production

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=medmatch
DATABASE_USER=replace-with-production-db-user
DATABASE_PASSWORD=replace-with-a-long-production-db-password

JWT_SECRET=replace-with-a-long-random-production-jwt-secret
JWT_ISSUER=medmatch
JWT_AUDIENCE=medmatch-client
FRONTEND_URL=https://your-production-domain.example
VITE_API_URL=https://your-production-domain.example
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=replace-with-mailbox-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=MedMatch
SMTP_ALLOW_INVALID_CERTIFICATE=false

HARBOR_REGISTRY=registry.example.com
HARBOR_PROJECT=medmatch
IMAGE_TAG=latest

# LLM content moderation for provider recommendations (optional).
# Set ENABLED=true and fill API_URL/API_KEY to have an OpenAI-compatible
# chat-completions endpoint verify that recommendations are positive before
# they are published. When disabled, AUTO_APPROVE decides whether new
# recommendations publish immediately (true) or wait for admin review (false).
LLM_MODERATION_ENABLED=false
LLM_MODERATION_API_URL=
LLM_MODERATION_API_KEY=
LLM_MODERATION_MODEL=gpt-4o-mini
LLM_MODERATION_AUTO_APPROVE=false

# Symptom free-text tag extraction.
# dictionary = match symptom words against known diagnosis tags (default)
# llm        = planned LLM extraction (falls back to dictionary for now)
# off        = disabled
SYMPTOM_TAG_EXTRACTION=dictionary

# Self-hosted machine translation (LibreTranslate) for on-demand user-content translation.
LIBRETRANSLATE_URL=http://libretranslate:5000

# OpenTelemetry / Grafana Alloy & Loki Observability
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
OTEL_AUTH_TOKEN=your-OTEL_AUTH_TOKEN
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer our-OTEL_AUTH_TOKEN
OTEL_SERVICE_NAME=medmatch-backend
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
VITE_OTEL_AUTH_TOKEN=your-OTEL_AUTH_TOKEN
VITE_OTEL_SERVICE_NAME=medmatch-frontend
